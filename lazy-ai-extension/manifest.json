{
  "manifest_version": 3,
  "name": "Lizzie",
  "version": "0.1.0",
  "description": "Polish your messy prompts in place — without leaving the tab. Talks to the Lizzie desktop app.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:8788/*"],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["Lizzie_Logo.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "Lizzie_Logo.png",
    "48": "Lizzie_Logo.png",
    "128": "Lizzie_Logo.png"
  },
  "action": {
    "default_title": "Lizzie — polish the focused text box",
    "default_icon": {
      "16": "Lizzie_Logo.png",
      "48": "Lizzie_Logo.png",
      "128": "Lizzie_Logo.png"
    }
  }
}
